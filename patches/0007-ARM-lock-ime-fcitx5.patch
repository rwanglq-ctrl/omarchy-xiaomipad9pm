---
 bin/omarchy-lock-ime           | 21 +++++++++++++++++++++
 shell/plugins/lock/Service.qml | 13 +++++++++++++
 2 files changed, 34 insertions(+)
 create mode 100755 bin/omarchy-lock-ime

diff --git a/bin/omarchy-lock-ime b/bin/omarchy-lock-ime
new file mode 100755
index 00000000..47aa5cd3
--- /dev/null
+++ b/bin/omarchy-lock-ime
@@ -0,0 +1,21 @@
+#!/bin/bash
+
+# omarchy:summary=Turn fcitx5 off while the session is locked, restore it after unlock
+# omarchy:hidden=true
+# ARM 容器移植：Hyprland 锁屏时 input-method 仍抓着之前窗口（如 foot）的键盘，
+# Rime 开着就会把密码框的字母吃进拼音预编辑。锁屏时切英文，解锁后按原样恢复。
+
+state="${XDG_RUNTIME_DIR:-/tmp}/omarchy-lock-ime"
+command -v fcitx5-remote >/dev/null || exit 0
+
+echo "$(date +%T.%N) $1 state=$(fcitx5-remote 2>&1) im=$(fcitx5-remote -n 2>&1)" >>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-lock-ime.log"
+case $1 in
+  off)
+    [[ $(fcitx5-remote 2>/dev/null) == 2 ]] && touch "$state"
+    fcitx5-remote -c 2>/dev/null
+    ;;
+  restore)
+    [[ -f $state ]] && rm -f "$state" && fcitx5-remote -o 2>/dev/null
+    ;;
+esac
+exit 0
diff --git a/shell/plugins/lock/Service.qml b/shell/plugins/lock/Service.qml
index 49b93e0c..c5d2d02b 100644
--- a/shell/plugins/lock/Service.qml
+++ b/shell/plugins/lock/Service.qml
@@ -74,6 +74,7 @@ Item {
 
     pendingSessionLock = false
     pendingSessionLockTimer.stop()
+    lockImeOffProcess.running = true
     sessionLock.locked = true
   }
 
@@ -157,6 +158,7 @@ Item {
     idleBlankTimer.stop()
     sessionLock.locked = false
     logEvent("unlocked")
+    lockImeRestoreProcess.running = true
     runWake()
   }
 
@@ -402,6 +404,17 @@ Item {
     }
   }
 
+  // ARM 容器移植：锁屏时关闭 fcitx5，解锁后恢复，防止 Rime 预编辑吃掉密码输入
+  Process {
+    id: lockImeOffProcess
+    command: ["bash", "-c", "omarchy-lock-ime off"]
+  }
+
+  Process {
+    id: lockImeRestoreProcess
+    command: ["bash", "-c", "omarchy-lock-ime restore"]
+  }
+
   Process {
     id: wakeProcess
     command: ["bash", "-c", "omarchy-system-wake"]
