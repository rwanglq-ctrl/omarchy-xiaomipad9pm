 =?UTF-8?q?=EF=BC=9Afcitx5=20=E6=94=B9=E7=94=A8=20~/.local/bin/fcitx5-auto?=
 =?UTF-8?q?start=EF=BC=88=E4=BB=8E=20Debian=20=E7=A7=BB=E6=A4=8D=EF=BC=89?=
